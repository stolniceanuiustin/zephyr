menuconfig JESD204
	bool "JESD204 bring-up framework"
	help
	  Enable the generic, board-agnostic JESD204 bring-up state machine
	  that walks every device on a link through the phases DEVICE_INIT
	  to LINK_RUNNING.

if JESD204

module = JESD204
module-str = JESD204
source "subsys/logging/Kconfig.template.log_config"

endif # JESD204
